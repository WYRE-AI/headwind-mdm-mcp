{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.WYRE-AI/headwind-mdm-mcp",
  "title": "Headwind MDM",
  "description": "MCP server for the Headwind MDM REST API.",
  "repository": {
    "url": "https://github.com/asachs01/headwind-mdm-mcp.git",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/asachs01/headwind-mdm-mcp",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wyre-ai/headwind-mdm-mcp:0.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MCP_TRANSPORT",
          "description": "Run the image over stdio (the image default is http).",
          "value": "stdio",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "AUTH_MODE",
          "description": "Read Headwind MDM credentials from HMDM_USERNAME/HMDM_PASSWORD (the image default is gateway).",
          "value": "env",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "HMDM_BASE_URL",
          "description": "Headwind MDM server root, e.g. https://mdm.example.com (/rest is appended automatically). Required; no default.",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "HMDM_USERNAME",
          "description": "Headwind MDM username",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HMDM_PASSWORD",
          "description": "Headwind MDM password",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HMDM_TOOL_TIERS",
          "description": "Comma-separated tool tiers",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}

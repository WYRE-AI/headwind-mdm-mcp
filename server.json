{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.asachs01/headwind-mdm-mcp",
  "title": "Headwind MDM",
  "description": "MCP server for the Headwind MDM REST API.",
  "repository": {
    "url": "https://github.com/asachs01/headwind-mdm-mcp.git",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/asachs01/headwind-mdm-mcp",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/asachs01/headwind-mdm-mcp:0.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HMDM_BASE_URL",
          "description": "Headwind MDM REST base URL",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "HMDM_USERNAME",
          "description": "Headwind MDM username",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HMDM_PASSWORD",
          "description": "Headwind MDM password",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "HMDM_TOOL_TIERS",
          "description": "Comma-separated tool tiers",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}

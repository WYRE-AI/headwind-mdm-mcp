# Headwind MDM server root (required; no default). "/rest" is appended automatically.
# https only (any host, including private addresses); http only for localhost / 127.0.0.1.
HMDM_BASE_URL=https://mdm.example.com
# Account used in AUTH_MODE=env (stdio, or HTTP with AUTH_MODE=env). Never commit real values.
# In AUTH_MODE=gateway these are ignored: credentials arrive per request in the
# X-HMDM-Username / X-HMDM-Password headers.
HMDM_USERNAME=
HMDM_PASSWORD=
# Comma-separated tiers to expose: read, write, admin (default: read)
HMDM_TOOL_TIERS=read

AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
# Required for HTTP: >= 32 chars (openssl rand -hex 32); placeholders are rejected
CONDUIT_S2S_SECRET=
# Extra allowed Host header values (no ports), comma separated; DNS-rebinding protection
# MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOW_INSECURE_DEV=0
LOG_LEVEL=info
